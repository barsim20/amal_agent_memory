# =============================================================================
# AMAL MEMORY & DREAMING — EXAMPLE ENVIRONMENT & CREDENTIALS FILE
# Copy this file to `.env` (which is git-ignored) and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Anthropic / Claude Haiku Credentials (Chat & Memory Extraction LLM)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-ANTHROPIC-API-KEY-HERE
AMAL_CHAT_MODEL=claude-3-5-haiku-latest
AMAL_EXTRACTION_MODEL=claude-3-5-haiku-latest
AMAL_DREAM_MODEL=claude-3-5-haiku-latest

# Optional LiteLLM Proxy (if routing Claude calls through LiteLLM)
# LITELLM_BASE_URL=https://litellm.amal.education/v1
# LITELLM_API_KEY=sk-litellm-YOUR-KEY-HERE

# -----------------------------------------------------------------------------
# 2. Supabase PostgreSQL Database Credentials
# Copy from Supabase Dashboard -> Connect -> Session Pooler URI (Port 5432)
# Leave DATABASE_URL blank to use local SQLite (db.sqlite3) for quick local testing
# -----------------------------------------------------------------------------
DATABASE_URL=
# Example:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional discrete Supabase / Postgres credentials (used if DATABASE_URL is empty)
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.[YOUR-PROJECT-REF]
DB_PASSWORD=
DB_SSLMODE=require

# Optional Supabase API credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# -----------------------------------------------------------------------------
# 3. Django & Amal Memory Security Settings
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=amal-memory-dev-secret-key-change-in-production
DJANGO_DEBUG=true
AMAL_MEMORY_TOMBSTONE_SECRET=amal-tombstone-hmac-key-2026
AMAL_EMBED_MODEL=AfriE5-Large-Instruct-halfvec1024
AMAL_TAXONOMY_STAGE=phase3_full_auto
