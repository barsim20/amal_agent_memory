# Supabase PostgreSQL Connection (Session / Direct Pooler on Port 5432 recommended for Django migrations & SET LOCAL RLS)
# Copy from Supabase Dashboard -> Connect -> URI (Session Pooler or Direct Connection)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional discrete Postgres variables (used if DATABASE_URL is not set)
# DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.[YOUR-PROJECT-REF]
# DB_PASSWORD=[YOUR-DB-PASSWORD]
# DB_SSLMODE=require

# Amal Memory & Dreaming Secrets & Settings
DJANGO_SECRET_KEY=change-me-in-production
AMAL_MEMORY_TOMBSTONE_SECRET=amal-tombstone-hmac-key-2026
AMAL_EMBED_MODEL=AfriE5-Large-Instruct-halfvec1024
AMAL_TAXONOMY_STAGE=phase3_full_auto
